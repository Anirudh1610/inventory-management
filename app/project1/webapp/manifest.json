{
  "_version": "1.89.0",
  "sap.app": {
    "id": "project1",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.33.0",
      "toolsId": "a1effc27-8df5-410e-8cf4-4ef3d72a770a"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/inventory/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "project1.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [

        {
          "pattern": ":?query:",
          "name": "ProductsList",
          "target": "ProductsList"
        },
        {
          "pattern": "Products({key}):?query:",
          "name": "ProductsObjectPage",
          "target": "ProductsObjectPage"
        },
        {
          "pattern": "Categories:?query:",
          "name": "CategoriesList",
          "target": "CategoriesList"
        },
        {
          "pattern": "Categories({key}):?query:",
          "name": "CategoriesObjectPage",
          "target": "CategoriesObjectPage"
        },
        {
          "pattern": "Categories({key})/products({key2}):?query:",
          "name": "CategoriesProductsObjectPage",
          "target": "CategoriesProductsObjectPage"
        },
                {
          "pattern": "Suppliers:?query:",
          "name": "SuppliersList",
          "target": "SuppliersList"
        },
        {
          "pattern": "Suppliers({key}):?query:",
          "name": "SuppliersObjectPage",
          "target": "SuppliersObjectPage"
        },
        {
          "pattern": "Suppliers({key})/products({key2}):?query:",
          "name": "SuppliersProductsObjectPage",
          "target": "SuppliersProductsObjectPage"
        }
      ],

      "targets": {
        "ProductsList": {
          "type": "Component",
          "id": "ProductsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Products",
              "variantManagement": "Page",
              "navigation": {
                "Products": {
                  "detail": {
                    "route": "ProductsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "toCategories": {
                      "press": "project1.ext.controller.Navigation.toCategories",
                      "text": "Categories",
                      "requiresSelection": false
                    },
                    "toSuppliers": {
                      "press": "project1.ext.controller.Navigation.toSuppliers",
                      "text": "Suppliers",
                      "requiresSelection": false
                    }
                  }

                }
              }
            }
          }
        },
        "ProductsObjectPage": {
          "type": "Component",
          "id": "ProductsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Products"
            }
          }
        },
        "CategoriesList": {
          "type": "Component",
          "id": "CategoriesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Categories",
              "initialLoad": "Enabled",
              "navigation": {
                "Categories": {
                  "detail": {
                    "route": "CategoriesObjectPage"
                  }
                }
              }
            }
          }
        },
                "CategoriesObjectPage": {
          "type": "Component",
          "id": "CategoriesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Categories",
              "navigation": {
                "products": {
                  "detail": {
                    "route": "CategoriesProductsObjectPage"
                  }
                }
              }
            }
          }
        },
        "CategoriesProductsObjectPage": {
          "type": "Component",
          "id": "CategoriesProductsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Categories/products"
            }
          },
                  "SuppliersList": {
          "type": "Component",
          "id": "SuppliersList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Suppliers",
              "initialLoad": "Enabled",
              "navigation": {
                "Suppliers": {
                  "detail": {
                    "route": "SuppliersObjectPage"
                  }
                }
              }
            }
          }
        },
        "SuppliersObjectPage": {
          "type": "Component",
          "id": "SuppliersObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Suppliers",
              "navigation": {
                "products": {
                  "detail": {
                    "route": "SuppliersProductsObjectPage"
                  }
                }
              }
            }
          }
        },
        "SuppliersProductsObjectPage": {
          "type": "Component",
          "id": "SuppliersProductsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Suppliers/products"
            }
          }
        }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
